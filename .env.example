# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# ─── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Get both URLs from your Neon dashboard → Connection Details → Connection string
# Select "Pooled connection" for DATABASE_URL and "Direct connection" for DIRECT_URL.

# Pooled connection — used by the app at runtime (via @prisma/adapter-neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct connection — used by Prisma CLI for migrations & introspection
DIRECT_URL=""

# ─── App ──────────────────────────────────────────────────────────────────────
# Canonical origin used to build password-reset/verify-email links. Never derive
# this from request headers (Host header injection). Defaults to
# http://localhost:3000 if unset — set explicitly in production.
APP_URL=""

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a secret: npx auth secret
AUTH_SECRET=""

# GitHub OAuth (optional — create at github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─── Resend (email verification) ─────────────────────────────────────────────
RESEND_API_KEY=""
# Optional — defaults to Resend's shared test sender if unset. Use a verified
# domain sender in production, e.g. "DevStash <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=""

# ─── Upstash Redis (auth rate limiting) ───────────────────────────────────────
# Get both from your Upstash console → Redis database → REST API.
# Rate limiting fails open (allows requests) if either is unset.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Test-mode keys from Stripe Dashboard → Developers → API keys. Hosted Checkout
# needs no publishable key. Price IDs come from the "DevStash Pro" product.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""
# Free-plan limits are only enforced when "true".
BILLING_ENFORCED="false"

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
